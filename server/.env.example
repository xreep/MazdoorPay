NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mazdoorpay?retryWrites=true&w=majority
# For local dev without Atlas, use: MONGODB_URI=mongodb://127.0.0.1:27017/mazdoorpay

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FRONTEND_ORIGIN=http://localhost:5173

BCRYPT_COST=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

SEED_MODE=true

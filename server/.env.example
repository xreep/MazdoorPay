NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mazdoorpay?retryWrites=true&w=majority
# For local dev without Atlas, use: MONGODB_URI=mongodb://127.0.0.1:27017/mazdoorpay

# At least 32 random characters each in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
QR_SECRET=replace-with-a-long-random-qr-secret

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

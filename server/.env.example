NODE_ENV=development
PORT=5055
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mazdoorpay?retryWrites=true&w=majority
# Payments and attendance use transactions, so MongoDB must be a replica set (Atlas always is).
# Local option: mongod --replSet rs0, then rs.initiate(), and use mongodb://127.0.0.1:27017/mazdoorpay?replicaSet=rs0
# No database at all? Run `npm run dev:memory -w server` instead.

# At least 32 random characters each in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
QR_SECRET=replace-with-a-long-random-qr-secret

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
# Proxy hops in front of the API: 1 on Render, 2 when the Vercel rewrite forwards to Render
TRUST_PROXY=1

# Passwords for the shared demo accounts, used by `npm run seed` and applied on every start.
# Letters and numbers, at least 12 characters in production. Never commit real values.
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
